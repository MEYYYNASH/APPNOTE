<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_notes_list_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_widget_glass"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_notes_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="GlassNotes"
            android:textColor="#FFFFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/widget_reminder_icon"
            android:layout_width="13dp"
            android:layout_height="13dp"
            android:layout_marginEnd="3dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_widget_bell"
            android:tint="#F472B6" />

        <TextView
            android:id="@+id/widget_reminder_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:text="10:00 AM"
            android:textColor="#F472B6"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_btn_add_note_large"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:background="@drawable/bg_widget_neon_pill"
            android:gravity="center"
            android:paddingHorizontal="10dp"
            android:text="+ Note"
            android:textColor="#FFFFFFFF"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ListView
        android:id="@+id/widget_notes_listview"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:divider="@null"
        android:dividerHeight="6dp" />

    <TextView
        android:id="@+id/widget_notes_empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:text="No notes found. Tap + Note to create one."
        android:textColor="#88FFFFFF"
        android:textSize="12sp"
        android:visibility="gone" />
</LinearLayout>
